<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.Controller">
    <children>

        <!-- Left: drawing area -->
        <Canvas fx:id="canvas" height="500.0" width="600.0" />

        <!-- Center: tools -->
        <VBox prefWidth="140.0" spacing="8.0" style="-fx-background-color: #eeeeee;">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <!-- Top: line width -->
                <Label style="-fx-font-weight: bold;" text="Width" />
                <fx:define>
                    <ToggleGroup fx:id="widthGroup" />
                </fx:define>
                <RadioButton fx:id="thinRadio" selected="true" text="Thin">
               <toggleGroup>
                  <ToggleGroup fx:id="widthGroup" />
               </toggleGroup></RadioButton>
                <RadioButton fx:id="thickRadio" text="Thick" toggleGroup="$widthGroup" />

                <!-- Push the colors to the bottom -->
                <Region VBox.vgrow="ALWAYS" />
                <Separator />

                <!-- Bottom: predefined colors -->
                <Label style="-fx-font-weight: bold;" text="Color" />
                <Canvas fx:id="colorsCanvas" height="60.0" width="120.0" />
            </children>
        </VBox>

        <!-- Right: objects list (to do) -->
        <VBox fx:id="vboxObjectes" prefWidth="160.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <Label style="-fx-font-weight: bold;" text="Objects" />
            </children>
        </VBox>

    </children>
</HBox>
